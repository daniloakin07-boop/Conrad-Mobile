{
  "expo": {
    "name": "Conrad Virtual School",
    "slug": "conrad-virtual-school",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "conrad",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1F44"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.conradvirtualschool.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1F44"
      },
      "package": "com.conradvirtualschool.app"
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite escolher fotos para o perfil e para o bate-papo."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Permite gravar mensagens de voz no bate-papo."
        }
      ]
    ],
    "extra": {
      "apiUrl": ""
    }
  }
}
